generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// What a user can do on the platform.
enum Role {
  CLIENT   // submits jobs
  PROVIDER // offers GPU machines
  ADMIN    // sees and manages everything
}

/// A person with an account.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  /// Never the password itself: a salted scrypt hash of it
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  jobs     Job[]
  machines Machine[]
}

/// A computer registered by a provider to run jobs on its GPUs.
model Machine {
  id          String    @id @default(uuid())
  name        String
  /// SHA-256 of the machine's secret token. The token itself is shown only once.
  tokenHash   String    @unique
  /// First characters of the token, so the owner can recognise it
  tokenPrefix String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs    Job[]

  @@index([ownerId])
}

enum JobStatus {
  PENDING
  COMPILING
  COMPILE_FAILED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
}

model Job {
  id             String    @id @default(uuid())
  name           String
  sourceCode     String
  status         JobStatus @default(PENDING)
  timeoutSeconds Int       @default(60)

  // Owner
  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Machine that ran (or is running) the job
  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  compilerOutput String?
  binaryPath     String?
  attempts   Int     @default(0)
  stdout     String?
  stderr     String?
  exitCode   Int?
  durationMs Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  @@index([status])
  @@index([createdAt])
  @@index([clientId, createdAt])
}
