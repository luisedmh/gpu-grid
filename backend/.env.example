DATABASE_URL="postgresql://gpugrid:gpugrid@localhost:5432/gpugrid?schema=public"
# Secret that provider agents must present. Use the same value in agent/.env.
AGENT_TOKEN="change-me-to-a-long-random-string"
# Secret that signs login sessions (JWT). Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-another-long-random-string"
