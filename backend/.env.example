DATABASE_URL="postgresql://gpugrid:gpugrid@localhost:5432/gpugrid?schema=public"
# Secret that signs login sessions (JWT). Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Credits (optional, these are the defaults)
# CREDITS_PER_GPU_SECOND=10
# PROVIDER_SHARE_PERCENT=80
# WELCOME_CREDITS=5000

# Docker image providers install the agent from
# AGENT_IMAGE=ghcr.io/luisedmh/gpu-grid-agent:latest
